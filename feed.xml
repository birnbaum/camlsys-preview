  <entry>
    <title type="html">Cambridge joins the SOFAIR Lab</title>
    <link href="https://philippwiesner.org/camlsys-preview/news/2026-06-23-sofair-launch/" rel="alternate" type="text/html" title="Cambridge joins the SOFAIR Lab"/>
    <published>2026-06-23T00:00:00+00:00</published>
    <updated>2026-06-23T00:00:00+00:00</updated>
    <id>https://philippwiesner.org/camlsys-preview/news/sofair-launch</id>
    <content type="html" xml:base="https://philippwiesner.org/camlsys-preview/news/2026-06-23-sofair-launch/"><![CDATA[]]></content>
    <author>
      <name/>
    </author>
    <summary type="html"><![CDATA[<p>Cambridge joins <a href="https://www.cst.cam.ac.uk/news/joining-science-fundamental-ai-research-lab-major-national-initiative">SOFAIR</a>, led by David Barber at UCL in partnership with Oxford and Edinburgh. Led by Nicholas Lane, our contribution focuses on training frontier AI models across wide-area networks of heterogeneous compute.</p>
]]></summary>
  </entry>
